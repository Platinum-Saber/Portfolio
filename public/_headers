# Cloudflare static-asset headers (Workers assets). See docs/DEPLOY-CLOUDFLARE.md.

# Content-hashed build output: safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Optimised models and media are not content-hashed, so a day at the edge and
# revalidation after that: long enough to matter, short enough that a re-export
# lands within a day.
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
