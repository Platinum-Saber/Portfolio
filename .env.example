# Copy to .env.local for local development. Never commit the real file.
#
# The site is designed to build and run correctly with every one of these
# unset - the contact form simply degrades to a mailto: link. Nothing on the
# render path reads them.

# Supabase - Project Settings → API.
# This is the ANON key, not the service role key. The anon key is public by
# design and is restricted by RLS to inserting rows it cannot read back. The
# service role key bypasses RLS entirely and must never be given to this app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# The following are NOT used by the Next.js app. They are set as secrets on the
# Supabase Edge Function (`supabase secrets set ...`), and are listed here only
# so the full picture lives in one place. See docs/PHASE-5-SUPABASE.md.
#
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# WEBHOOK_SECRET=a-long-random-string
#
# The Discord webhook URL is a credential, not an address: anyone holding it can
# post to that channel as often as Discord's rate limit allows. It is not the
# same secret as WEBHOOK_SECRET, which is what proves an inbound request to the
# function really came from Postgres.

# Notes (/notes/cse/*) - members-only study guides. docs/NOTES.md.
# Unset = the notes stay locked (sign-in reports "not configured"); the rest of
# the site is unaffected. On Cloudflare these are Worker SECRETS (runtime), not
# build variables: `npx wrangler secret put NOTES_AUTH_SECRET` etc.
#
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URIs:
#   https://sansikawaduge.dev/api/notes/auth/callback
#   http://localhost:3000/api/notes/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Signs the session cookie. 32+ characters. Rotating it signs everyone out.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NOTES_AUTH_SECRET=change-me-to-32-or-more-random-characters
